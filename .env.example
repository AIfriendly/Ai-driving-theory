# Copy to .env and fill in. NEVER commit .env (it is gitignored).
#
# Create API keys at https://www.bybit.com/app/user/api-management
# (testnet: https://testnet.bybit.com). Grant ONLY "Read" and "Trade"
# permissions — never "Withdraw" — and restrict the key to your IP.

# "testnet" (default) or "mainnet". Anything else refuses to start.
BYBIT_ENV=testnet

BYBIT_API_KEY=
BYBIT_API_SECRET=

# Master switch for place_order / cancel_order / set_leverage.
# Leave false for read-only analysis sessions.
BYBIT_TRADING_ENABLED=false

# Hard server-side leverage cap (the operating manual assumes 5x).
BYBIT_MAX_LEVERAGE=5

# Optional per-order notional cap in quote currency (USDT). 0 = disabled.
# Strongly recommended on mainnet, e.g. 500.
BYBIT_MAX_ORDER_VALUE=0

# Bybit auth receive window in milliseconds.
BYBIT_RECV_WINDOW=5000
