# Copy to .env and fill in. NEVER commit .env (it is gitignored).
#
# Create API keys at https://www.bybit.com/app/user/api-management
# (testnet: https://testnet.bybit.com). Grant ONLY "Read" and "Trade"
# permissions — never "Withdraw" — and restrict the key to your IP.

# "testnet" (default) or "mainnet". Anything else refuses to start.
BYBIT_ENV=testnet

# Optional explicit REST base URL. Use a regional endpoint that matches your
# account/jurisdiction, e.g. https://api.bybit.ae (UAE), https://api.bybit.eu
# (EEA). Leave blank to derive from BYBIT_ENV. NOTE: this is compliance/account
# routing only — it does NOT bypass the geo-block, which keys off your egress
# IP. The host running this server must already be in a permitted region.
BYBIT_BASE_URL=

BYBIT_API_KEY=
BYBIT_API_SECRET=

# Master switch for place_order / cancel_order / set_leverage.
# Leave false for read-only analysis sessions.
BYBIT_TRADING_ENABLED=false

# Hard server-side leverage cap (the operating manual assumes 5x).
BYBIT_MAX_LEVERAGE=5

# Optional per-order notional cap in quote currency (USDT). 0 = disabled.
# Strongly recommended on mainnet, e.g. 500. (Applies to opening orders;
# reduce_only exits are exempt so you can always close.)
BYBIT_MAX_ORDER_VALUE=0

# Bybit auth receive window in milliseconds.
BYBIT_RECV_WINDOW=5000

# -------------------------------------------------------------------------
# Autonomous (unattended) mode — the agent may place orders without a human
# CONFIRM. With no human in the loop the caps below are the ONLY backstop, so
# they are MANDATORY: while BYBIT_AUTONOMOUS=true the server refuses to OPEN a
# position until MAX_ORDER_VALUE, DAILY_LOSS_LIMIT, MAX_ORDERS_PER_DAY and
# SYMBOL_WHITELIST are all set. reduce_only exits are always allowed.
# Prove the whole loop on testnet before turning this on with real funds.
# -------------------------------------------------------------------------
BYBIT_AUTONOMOUS=false

# Daily loss kill-switch (quote ccy). If equity drops this far below the day's
# starting equity, OPENING new positions halts until the next UTC day.
BYBIT_DAILY_LOSS_LIMIT=0

# Max opening orders admitted per UTC day.
BYBIT_MAX_ORDERS_PER_DAY=0

# Max concurrent open positions (0 = unlimited).
BYBIT_MAX_OPEN_POSITIONS=0

# Minimum seconds between opening orders (rate limit against runaway loops).
BYBIT_ORDER_COOLDOWN_SEC=0

# Comma-separated symbols the agent may OPEN (exits are unrestricted).
BYBIT_SYMBOL_WHITELIST=

# Where the risk engine persists day/order counters. Blank => ~/.bybit/risk_state.json
BYBIT_STATE_PATH=

# ---------------------------------------------------------------------------
# Kurdish text-to-speech (video/ — the TikTok clips)
# ---------------------------------------------------------------------------
# kurdishtts.com API key, read by video/scripts/gen-voice.mjs. Free tier is
# 20,000 characters/month; all twenty clips together cost about 4,800, so
# there is no reason to pay for this.
#
# NEVER commit the real value. On Claude Code for the web, set it as an
# environment variable on the environment itself so it survives the container
# being reclaimed — a key that only lives in a session is gone with the
# session. Locally, put it in .env (already gitignored) or pass it inline:
#   KURDISH_TTS_KEY=... npm run voice -- --only helmet,glass
KURDISH_TTS_KEY=

# Buffer API token, read by video/scripts/publish-to-buffer.mjs, which schedules
# the clips to TikTok. Buffer's API is available on the free plan. Buffer is an
# audited TikTok partner, which is the whole reason to go through them rather
# than TikTok's Content Posting API — an unaudited client there can only post
# SELF_ONLY, i.e. to nobody.
#
# Same rule as above: never commit the value; set it on the environment so it
# survives the container being reclaimed.
BUFFER_ACCESS_TOKEN=
